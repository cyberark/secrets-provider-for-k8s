{
  "$schema": "http://json-schema.org/schema",
  "required": [
    "rbac",
    "secretsProvider",
    "environment"
  ],
  "allOf": [
    {
      "if": {
        "allOf": [
          { "required": ["containerMode"] },
          { "properties": { "containerMode": { "const": "standalone" } } }
        ]
      },
      "then": {
        "properties": {
          "environment": {
            "required": ["conjur"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "containerMode": { "const": "application" } }
      },
      "then": {
        "properties": {
          "environment": {
            "required": ["k8sSecrets", "conjur"]
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "autoReload": { "properties": { "enabled": { "const": true } } } } },
          {
            "anyOf": [
              { "properties": { "standalone": { "properties": { "namespaceAllowlist": { "pattern": "^\\s*\\*\\s*$" } } } } },
              { "properties": { "standalone": { "properties": { "namespaceAllowlist": { "pattern": ".*,.*" } } } } }
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "reloader": {
            "properties": {
              "reloader": {
                "properties": {
                  "watchGlobally": { "const": true }
                },
                "required": ["watchGlobally"]
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "containerMode": {
      "type": "string",
      "enum": ["application", "standalone"]
    },
    "standalone": {
      "type": "object",
      "properties": {
        "namespaceAllowlist": { "type": "string" },
        "secretsRefreshEnabled": { "type": "boolean" },
        "secretsRefreshInterval": { "type": "string" },
        "removeDeletedSecretsEnabled": { "type": "boolean" }
      }
    },
    "rbac": {
      "properties": {
        "create": {
          "type": "boolean"
        },
        "roleName": {
          "type": "string",
          "minLength": 1
        },
        "roleBindingName": {
          "type": "string",
          "minLength": 1
        },
        "serviceAccount": {
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "secretsProvider": {
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": ["string", "number"],
          "minLength": 1,
          "pattern": "(^\\d+(\\.\\d+){0,2}|latest)$"
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "workloadName": {
          "type": ["string", "null"],
          "description": "Name of the Job (application mode) or Deployment (standalone mode). Defaults to Helm Release."
        },
        "jobName": {
          "type": ["string", "null"],
          "description": "Deprecated: Use workloadName instead."
        }
      }
    },
    "labels": {
      "type": "object"
    },
    "annotations": {
      "type": "object"
    },
    "environment": {
      "required": ["conjur"],
      "properties": {
        "k8sSecrets": {
          "type": "array",
          "minLength": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conjur": {
          "if": {
            "allOf": [
              {
                "not": {
                  "properties": {
                    "authnJWT": {
                      "properties": {
                        "projectToken": {
                          "enum": [ true ]
                        }
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "authnUrl"
                ]
              },
              {
                "not": {
                  "properties": {
                    "authnUrl": {
                      "pattern": ".*/authn-jwt/.*"
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "authnLogin"
            ],
            "properties": {
              "authnLogin": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "conjurConnConfigMap"
              ]
            },{
              "required": [
                "account",
                "applianceUrl",
                "authnUrl"
              ],
              "properties": {
                "sslCertificate": {
                  "required": [ "value" ]
                }
              }
            }
          ],
          "properties": {
            "account": {
              "type": ["string","null"],
              "minLength": 1
            },
            "applianceUrl": {
              "type": ["string","null"],
              "minLength": 1,
              "pattern": "^https?://[^\\s/$.?#].[^\\s]*$"
            },
            "authnUrl": {
              "type": ["string","null"],
              "minLength": 1,
              "pattern": "^https?://[^\\s/$.?#].[^\\s]*$"
            },
            "authnLogin": {
              "type": ["string", "null"]
            },
            "conjurConnConfigMap": {
              "type": ["string","null"],
              "minLength": 1
            },
            "retryIntervalSec": {
              "type": "number",
              "minimum": 1,
              "description": "Retry delay between attempts in seconds."
            },
            "retryCountLimit": {
              "type": "number",
              "minimum": -1,
              "description": "Maximum number of retry attempts; set to -1 to retry indefinitely (unlimited)."
            },
            "sslCertificate": {
              "type": "object",
              "properties": {
                "name": {
                  "type": ["string"],
                  "minLength": 1
                },
                "value": {
                  "type": ["string","null"],
                  "minLength": 1
                }
              }
            },
            "authnJWT": {
              "type": "object",
              "properties": {
                "projectToken": {
                  "type": "boolean"
                },
                "projectedFilename": {
                  "type": "string",
                  "minLength": 1
                },
                "audience": {
                  "type": "string",
                  "minLength": 1
                },
                "expiration": {
                  "type": "number",
                  "minimum": 1
                }
              }
            }
          }
        },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"]
        }
      }
    },
    "autoReload": {
      "type": "object",
      "description": "Controls whether the Reloader sub-chart is deployed",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Set to true to install Reloader as a sub-chart"
        }
      }
    },
    "reloader": {
      "type": "object",
      "description": "Reloader subchart configuration for automatic application restart on secret rotation",
      "allOf": [
        {
          "if": {
            "properties": {
              "reloader": {
                "properties": {
                  "deployment": {
                    "properties": {
                      "replicas": {
                        "minimum": 2
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "reloader": {
                "properties": {
                  "enableHA": {
                    "enum": [true]
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "description": "Reloader container image repository"
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "description": "Optional override; default tag is defined by the Reloader sub-chart"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "Immutable OCI digest for the Reloader image (pin supply chain)"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"],
              "description": "Container image pull policy"
            }
          }
        },
        "imageDigestReference": {
          "type": "object",
          "description": "Full OCI pull reference (registry/repository:tag) that image.digest was resolved against; update when mirror or tag changes",
          "properties": {
            "pullReference": {
              "type": "string",
              "minLength": 1,
              "description": "Canonical image reference for the pinned digest, e.g. docker.io/stakater/reloader:v1.4.13"
            }
          }
        },
        "reloader": {
          "type": "object",
          "description": "Reloader-specific configuration (maps to subchart's reloader.* values)",
          "properties": {
            "deployment": {
              "type": "object",
              "properties": {
                "replicas": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Number of Reloader replicas"
                }
              }
            },
            "enableHA": {
              "type": "boolean",
              "description": "Enable leadership election for running multiple replicas"
            },
            "watchGlobally": {
              "type": "boolean",
              "description": "When false, Reloader watches only the release namespace. Must be true when standalone.namespaceAllowlist is '*' or comma-separated (more than one namespace)."
            },
            "reloadStrategy": {
              "type": "string",
              "enum": ["annotations", "env-vars", "default"],
              "description": "Strategy Reloader uses to trigger rolling restarts"
            },
            "ignoreConfigMaps": {
              "type": "boolean",
              "description": "Ignore ConfigMap changes (Secrets Provider does not manage ConfigMaps)"
            },
            "ignoreJobs": {
              "type": "boolean",
              "description": "Ignore Job workloads (out of scope for rotation-triggered restarts)"
            },
            "ignoreCronJobs": {
              "type": "boolean",
              "description": "Ignore CronJob workloads (out of scope for rotation-triggered restarts)"
            },
            "custom_annotations": {
              "type": "object",
              "description": "Aliases Stakater annotations to the conjur.org namespace",
              "properties": {
                "secret_auto": {
                  "type": "string",
                  "description": "Alias for secret.reloader.stakater.com/auto (e.g. conjur.org/automatic-restart)"
                },
                "secret": {
                  "type": "string",
                  "description": "Alias for secret.reloader.stakater.com/reload (e.g. conjur.org/restart-secrets)"
                }
              }
            },
            "serviceAccount": {
              "type": "object",
              "properties": {
                "create": {
                  "type": "boolean",
                  "description": "Create service account for Reloader"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Name of service account for Reloader"
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU limit"
                },
                "memory": {
                  "type": "string",
                  "description": "Memory limit"
                }
              }
            },
            "requests": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "string",
                  "description": "CPU request"
                },
                "memory": {
                  "type": "string",
                  "description": "Memory request"
                }
              }
            }
          }
        },
        "rbac": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean",
              "description": "Create RBAC resources for Reloader"
            }
          }
        }
      }
    }
  }
}
