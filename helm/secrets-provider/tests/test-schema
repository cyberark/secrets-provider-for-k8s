# Schema can be skipped (e.g. --skip-schema-validation); templates/auto-reload-validation.yaml must still fail.
# Reloader deployment must use an immutable digest pin (not tag-only). CI also runs bin/reloader-image-digest.sh verify against the registry.
function reloader_deployment_uses_digest_pin_test() {
    local out
    out=$(helm template rel-test . \
        --set "$DEFAULT_ACCOUNT_SETTING" \
        --set "$DEFAULT_APPLIANCE_URL_SETTING" \
        --set "$DEFAULT_AUTHN_LOGIN_SETTING" \
        --set "$DEFAULT_AUTHN_URL_SETTING" \
        --set "$DEFAULT_SSL_CERT_SETTING" \
        --set "$DEFAULT_K8S_SECRETS_SETTING" \
        --set "autoReload.enabled=true" \
        --show-only charts/reloader/templates/deployment.yaml \
        2>&1) || {
        echo "helm template --show-only Reloader deployment failed" >&2
        echo "$out" >&2
        return 1
    }
    if ! echo "$out" | grep -qE 'image:.*@sha256:[a-f0-9]{64}'; then
        echo "expected Reloader Deployment container image to reference @sha256:<64-hex>" >&2
        echo "$out" >&2
        return 1
    fi
    return 0
}

function reloader_misconfig_skip_schema_triggers_template_fail_test() {
    local out rc
    set +e
    out=$(helm template rel-test . --skip-schema-validation \
        --set "containerMode=standalone" \
        --set "$DEFAULT_ACCOUNT_SETTING" \
        --set "$DEFAULT_APPLIANCE_URL_SETTING" \
        --set "$DEFAULT_AUTHN_LOGIN_SETTING" \
        --set "$DEFAULT_AUTHN_URL_SETTING" \
        --set "$DEFAULT_SSL_CERT_SETTING" \
        --set "autoReload.enabled=true" \
        --set "standalone.namespaceAllowlist=*" \
        --set "reloader.reloader.watchGlobally=false" \
        2>&1)
    rc=$?
    set -e
    if [[ "$rc" -eq 0 ]]; then
        echo "expected helm template to fail with Reloader misconfiguration" >&2
        return 1
    fi
    if ! echo "$out" | grep -q "Reloader with autoReload"; then
        echo "expected error from auto-reload-validation template" >&2
        echo "$out" >&2
        return 1
    fi
    if ! echo "$out" | grep -q "reloader.reloader.watchGlobally=true"; then
        echo "expected error to include remediation reloader.reloader.watchGlobally=true" >&2
        echo "$out" >&2
        return 1
    fi
    return 0
}

