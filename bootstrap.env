# Uncomment and set all variables below to run against Conjur Cloud tenant:
# export TENANT_ID=        # must be provided (format: abc1234)
# export TENANT_NAME       # must be provided
# export TENANT_USER=      # must be provided
# export TENANT_PASSWORD=  # must be provided

if [[ "${DEV:-false}" = "true" ]]; then
  export UNIQUE_TEST_ID="${UNIQUE_TEST_ID:-secrets-provider-dev}"
else
  export UNIQUE_TEST_ID="${UNIQUE_TEST_ID:-$(uuidgen | tr "[:upper:]" "[:lower:]" | head -c 10)}"
fi

export DEPLOY_MASTER_CLUSTER=true
export PLATFORM="${PLATFORM:-kubernetes}"
export KIND="${KIND:-false}"
export DEV="${DEV:-false}"

if [[ "${DEV}" = "true" ]]; then
  export TEST_PLATFORM="${TEST_PLATFORM:-gke}"
  export AUTHENTICATOR_ID="${AUTHENTICATOR_ID:-authn-dev-env}"
  export CONJUR_ACCOUNT="${CONJUR_ACCOUNT:-cucumber}"
  export APP_NAMESPACE_NAME="${APP_NAMESPACE_NAME:-local-secrets-provider}"
  export CONJUR_NAMESPACE_NAME="${CONJUR_NAMESPACE_NAME:-local-conjur}"
  export RUN_IN_DOCKER="${RUN_IN_DOCKER:-false}"
  export CONJUR_AUTHENTICATORS="${CONJUR_AUTHENTICATORS:-authn,authn-k8s/${AUTHENTICATOR_ID},authn-jwt/${AUTHENTICATOR_ID}}"
  export CONJUR_LOG_LEVEL="${CONJUR_LOG_LEVEL:-debug}"
  export LOG_LEVEL="${LOG_LEVEL:-debug}"
else
  export TEST_PLATFORM="${TEST_PLATFORM:-gke}"
  export CONJUR_ACCOUNT="${CONJUR_ACCOUNT:-account-${UNIQUE_TEST_ID}}"
  export AUTHENTICATOR_ID="${AUTHENTICATOR_ID:-conjur-${UNIQUE_TEST_ID}-test}"
  export CONJUR_AUTHENTICATORS="${CONJUR_AUTHENTICATORS:-authn,authn-k8s/${AUTHENTICATOR_ID},authn-jwt/${AUTHENTICATOR_ID},authn-iam/${AUTHENTICATOR_ID},authn-azure/${AUTHENTICATOR_ID},authn-gcp}"
  export APP_NAMESPACE_NAME="${APP_NAMESPACE_NAME:-app-${UNIQUE_TEST_ID}}"
  export CONJUR_NAMESPACE_NAME="${CONJUR_NAMESPACE_NAME:-conjur-${UNIQUE_TEST_ID}}"
fi

# Ensure Conjur deployment type is correct if the tenant details are provided
if [[ -n "${TENANT_ID:-}" \
  && -n "${TENANT_NAME:-}" \
  && -n "${TENANT_USER:-}" \
  && -n "${TENANT_PASSWORD:-}" ]]; then
  export CONJUR_DEPLOYMENT=cloud
fi

export CONJUR_APPLIANCE_IMAGE="${CONJUR_APPLIANCE_IMAGE:-registry.tld/conjur-appliance:5.0-stable}"
export CONJUR_FOLLOWER_COUNT="${CONJUR_FOLLOWER_COUNT:-1}"
export CONJUR_ADMIN_PASSWORD="${CONJUR_ADMIN_PASSWORD:-ADmin123!!!!}"
export TEST_RUNNER_IMAGE="${TEST_RUNNER_IMAGE:-runner-${UNIQUE_TEST_ID}}"
export SECRETS_MODE="${SECRETS_MODE:-k8s}"
export DEV_HELM="${DEV_HELM:-false}"
export HELM_TEST_APP_IMAGE="${HELM_TEST_APP_IMAGE:-debian:latest}"
export STOP_RUNNING_ENV="${STOP_RUNNING_ENV:-true}"
