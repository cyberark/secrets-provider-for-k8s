FROM alpine:latest

RUN mkdir -p /src
WORKDIR /src

RUN apk add --no-cache bash ca-certificates curl git jq gettext kind kubectl helm yq-go docker-cli libc6-compat bc openssl python3

# Install Google Cloud CLI
RUN curl -sSL https://sdk.cloud.google.com | bash -s -- --disable-prompts --install-dir=/usr/local
ENV PATH="/usr/local/google-cloud-sdk/bin:${PATH}"
RUN gcloud components install gke-gcloud-auth-plugin --quiet
RUN apk add --no-cache -X https://dl-cdn.alpinelinux.org/alpine/edge/community go

# Install Openshift CLI
ARG TARGETARCH
RUN OC_ARCH=$([ "$TARGETARCH" = "arm64" ] && echo "aarch64" || echo "x86_64") && \
    curl -fsSL "https://mirror.openshift.com/pub/openshift-v4/${OC_ARCH}/clients/ocp/stable/openshift-client-linux.tar.gz" \
      -o oc.tar.gz && \
    tar -xzf oc.tar.gz oc && \
    mv oc /usr/local/bin/ && \
    rm oc.tar.gz

RUN git config --global --add safe.directory /src

RUN mkdir -p /secrets-provider-for-k8s
WORKDIR /secrets-provider-for-k8s

COPY go.mod go.sum /secrets-provider-for-k8s/

COPY . .

WORKDIR /src
