#!/bin/bash
set -euo pipefail

# Runs Helm unit and schema validation tests in a Docker container.
# Requires Helm 3.18+ (for latest helm-unittest plugin) and Helm 3.5.3+ (schema tests).
# Can be run locally or from Jenkins.
helm_version=3.18.0

docker run --rm \
  -v "$PWD:/workspace" \
  -w /workspace/helm/secrets-provider/tests \
  --entrypoint "" \
  alpine/helm:${helm_version} \
  sh -c '
    apk add --no-cache bash > /dev/null

    set -eu

    retry() {
      attempts="${1}"
      shift
      delay=5
      count=1

      until "$@"; do
        if [ "${count}" -ge "${attempts}" ]; then
          echo "Command failed after ${count} attempts: $*" >&2
          return 1
        fi

        echo "Command failed (attempt ${count}/${attempts}): $*" >&2
        echo "Retrying in ${delay}s..." >&2
        sleep "${delay}"
        count=$((count + 1))
        delay=$((delay * 2))
      done
    }

    if ! helm plugin list 2>/dev/null | grep -q unittest; then
      helm plugin install https://github.com/helm-unittest/helm-unittest
    fi

    helm repo add stakater https://stakater.github.io/stakater-charts --force-update > /dev/null
    retry 3 helm repo update stakater > /dev/null
    retry 3 helm dependency update /workspace/helm/secrets-provider > /dev/null

    if [ -z "$(ls -1 /workspace/helm/secrets-provider/charts/*.tgz 2>/dev/null)" ]; then
      echo "helm dependency update did not produce any chart package in /workspace/helm/secrets-provider/charts" >&2
      exit 1
    fi

    ./test-unit && ./test-schema
  '
